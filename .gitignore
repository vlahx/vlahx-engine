.venv/
venv/
*_to_del
__pycache__/
*.pyc
.DS_Store
*.swp

# Baza de date (se creează automat la inițializare)
db/
*.db
*.sqlite
*.sqlite3

# Documentație de dezvoltare
!docs
!docs/**

# Teme (doar tema minimal este integrată în Core)
app/themes/*
!app/themes/minimal
!app/themes/minimal/**

app/static/themes/*
!app/static/themes/minimal
!app/static/themes/minimal/**

# Plugin-uri (aplicația este cheală în Git; plugin-urile sunt păstrate ca arhive în /zips)
app/plugins/*
!app/plugins/.gitkeep

# Arhive ZIP cu plugin-uri (excluse din Git; descărcare oficială exclusivă de pe camionagiul.club)
zips/
*.zip

# Fără nicio poză sau fișier media (static/images, static/uploads, static/downloads)
app/static/images/*
!app/static/images/.gitkeep
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/downloads/*
!app/static/downloads/.gitkeep

# Temporary backup folders
*_old*/
*_bak*/
*_root_old/
db_old_root/

# Internal notes & rules
internal_notes/
RULES.md
TODO.md

# Storage folder for repo.vlahx.org
app/storage/
